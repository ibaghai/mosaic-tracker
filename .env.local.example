# ─────────────────────────────────────────────────────────────────────────────
# Local env for the feat/job-search-v1 branch.
#
# Copy this file to `.env.local` and fill in keys. `.env.local` is git-ignored
# and auto-loaded at startup by db/env_loader.py (no python-dotenv needed).
#
# Vars already set in your shell take precedence over this file.
# ─────────────────────────────────────────────────────────────────────────────

# Use a separate SQLite file so v1 work doesn't touch your live tracker.db.
TRACKER_DB_PATH=./data/tracker_v1.db


# ── Apollo.io (people data) ──────────────────────────────────────────────────
# API key from https://app.apollo.io → Settings → Integrations → API.
# Leave empty (or set APOLLO_MOCK=1) to develop against canned mock data.
APOLLO_API_KEY=

# Cost guards. The Apollo wrapper refuses to call once any cap is hit.
# Resets at UTC midnight (daily) and on the 1st of each month UTC.
APOLLO_DAILY_CAP_CALLS=50
APOLLO_MONTHLY_CAP_CALLS=500
APOLLO_DAILY_CAP_CREDITS=200
APOLLO_MONTHLY_CAP_CREDITS=2000

# Force mock mode even if APOLLO_API_KEY is set (offline testing).
# APOLLO_MOCK=1


# ── LLM provider (any OpenAI-compatible endpoint) ───────────────────────────
# Pick ONE preset below by uncommenting its three lines. The shared helper at
# analysis/llm.py POSTs to {LLM_API_BASE}/chat/completions with the bearer key.

# --- Cerebras (recommended primary — fastest inference, generous free tier) ---
# Sign up: https://cloud.cerebras.ai
# LLM_API_BASE=https://api.cerebras.ai/v1
# LLM_API_KEY=csk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=llama-3.3-70b

# --- OpenRouter (best for flexibility — single key, free `:free` models) ---
# Sign up: https://openrouter.ai
# LLM_API_BASE=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Groq (original — free tier exists but rate-limited for personal use) ---
# Sign up: https://console.groq.com
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (cheap, generous free tier) ---
# Sign up: https://aistudio.google.com → API keys
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-2.5-flash

# --- OpenAI (paid, very cheap for gpt-4o-mini) ---
# Sign up: https://platform.openai.com
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# --- Together AI (paid, $5 trial credit) ---
# LLM_API_BASE=https://api.together.xyz/v1
# LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Optional: explicit provider name for DB-recorded metadata. Auto-derived from
# the API base URL if not set.
# LLM_PROVIDER=openrouter

# Backwards compat: if you only set GROQ_API_KEY (the old single-provider env
# var), the helper falls back to Groq automatically.
# GROQ_API_KEY=
